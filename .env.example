# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# OpenRouter key (used for voice transcription via Gemini)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenClaw agent id (headless brain)
OPENCLAW_AGENT=main

# Full path to node.exe and openclaw.mjs (auto-detected if left blank)
NODE_BIN=
OPENCLAW_MJS=

# Only this Telegram user id may talk to the bot (others are ignored)
OWNER_ID=
